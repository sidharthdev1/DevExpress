<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:padding="16dp">

    <!-- Screen Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CLI Command Reference"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap any command to copy it to your clipboard"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <!-- Search Input Bar -->
    <EditText
        android:id="@+id/et_search_cli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:hint="Search Docker, K8s, Git commands..."
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:padding="12dp"
        android:layout_marginBottom="14dp"
        android:inputType="text" />

    <!-- List of CLI Commands -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_cli_commands"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>